# AI Developer Copilot - Environment Configuration Template
# Copy this file to .env (do not commit .env to source control)

# Environment Mode (development / staging / production)
APP_ENV=development

# Local Ollama Configuration (Apple Silicon Mac M1 optimized)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT_SECONDS=60.0

# Security Bounds
MAX_CODE_LENGTH=5000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Repository Intelligence (Phase 7 - Server Allowlist)
# Format: id:/absolute/path/to/repo or id=/absolute/path/to/repo or JSON object
# Example: APPROVED_REPOSITORY_ROOTS=myproject:/Users/username/Projects/myproject
APPROVED_REPOSITORY_ROOTS=

# Repository Scanning Limits
REPO_MAX_FILES=300
REPO_MAX_FILE_SIZE_BYTES=102400
REPO_MAX_AGGREGATE_BYTES=3145728
REPO_MAX_TREE_DEPTH=12
REPO_MAX_CONTEXT_FILES=5
REPO_MAX_CONTEXT_CHARS=8000
REPO_MAX_CONVERSATION_TURNS=6

